# Every process.env key the repo reads is listed here. Never put a real value in this file.

# Data source for server pages and /api routes: "fake" serves the seed (default), "real" is Phase 2.
ADAPTER_MODE=fake

# Set by next.config.ts at build from public/brand/*.png. Leave empty.
NEXT_PUBLIC_BRAND_FILES=

# Optional, build-time only. Read by scripts/adaption_invent.py (never by the Next.js app or
# Vercel) to generate the painter phrase set with Adaption Invent.
# Get it from your Adaption Labs dashboard: https://adaptionlabs.ai
ADAPTION_API_KEY=
